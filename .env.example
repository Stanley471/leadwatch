# Database
DB_PATH=./leadwatch.db
LOG_LEVEL=INFO
POLL_INTERVAL=15m

# Reddit API credentials (required for Reddit polling)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram Alerting (required for owner alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API (for LLM-assisted classification & drafting)
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-3-5-haiku-20241022
DRAFTER_MODEL=claude-3-5-sonnet-20241022
